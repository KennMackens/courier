{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": false,
    "outDir": "dist/main",
    "rootDir": "src/main"
  },
  "include": ["src/main/**/*", "vite.config.ts"]
}
